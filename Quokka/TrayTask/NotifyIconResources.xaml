<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Quokka.TrayTask"
  xmlns:tb="http://www.hardcodet.net/taskbar">
  <!-- Shared icon image resources for submenus -->
  <BitmapImage x:Key="PluginMenuIcon" x:Shared="false" UriSource="pack://siteoforigin:,,,/Config/Resources/plugin.png" />
  <BitmapImage x:Key="FolderMenuIcon" x:Shared="false" UriSource="pack://siteoforigin:,,,/Config/Resources/folder.png" />
  <BitmapImage x:Key="SettingsMenuIcon" x:Shared="false" UriSource="pack://siteoforigin:,,,/Config/Resources/settings.png" />

  <!-- Context Menu styles -->
  <Style TargetType="{x:Type ContextMenu}">
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Grid Background="Transparent">
            <Border
              Margin="{DynamicResource TrayTaskContextMenuMargin}"
              Background="{DynamicResource TrayTaskContextMenuColor}"
              BorderBrush="{DynamicResource TrayTaskContextMenuBorderColor}"
              BorderThickness="{DynamicResource TrayTaskContextMenuBorderThickness}"
              CornerRadius="{DynamicResource TrayTaskContextMenuRounding}">
              <Border.Effect>
                <DropShadowEffect
                  BlurRadius="{DynamicResource TrayTaskContextMenuDropShadowBlurRadius}"
                  Direction="{DynamicResource TrayTaskContextMenuDropShadowDirection}"
                  Opacity="{DynamicResource TrayTaskContextMenuDropShadowOpacity}"
                  RenderingBias="{DynamicResource TrayTaskContextMenuDropShadowRenderingBias}"
                  ShadowDepth="{DynamicResource TrayTaskContextMenuDropShadowShadowDepth}" />
              </Border.Effect>
              <ScrollViewer
                Uid="ScrollViewer_9"
                CanContentScroll="False"
                Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer,
                                                              TypeInTargetAssembly={x:Type FrameworkElement}}}">
                <ItemsPresenter
                  Margin="{TemplateBinding Padding}"
                  KeyboardNavigation.DirectionalNavigation="Cycle"
                  UseLayoutRounding="{TemplateBinding UseLayoutRounding}" />
              </ScrollViewer>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!--  Menu Item styles  -->
  <Style TargetType="{x:Type MenuItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Grid x:Name="Grid">
            <Border
              x:Name="Border"
              Margin="{DynamicResource TrayTaskContextMenuItemMargin}"
              Background="{DynamicResource TrayTaskContextMenuItemColor}"
              BorderBrush="{DynamicResource TrayTaskContextMenuItemBorderColor}"
              BorderThickness="{DynamicResource TrayTaskContextMenuItemBorderThickness}"
              CornerRadius="{DynamicResource TrayTaskContextMenuItemRounding}"
              UseLayoutRounding="True">
              <Grid x:Name="InnerGrid">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition
                    x:Name="Col0"
                    Width="Auto"
                    MinWidth="17"
                    SharedSizeGroup="MenuItemIconColumnGroup" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="MenuTextColumnGroup" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="SubMenuArrowColumnGroup" />
                </Grid.ColumnDefinitions>
                <ContentPresenter
                  x:Name="Icon"
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  ContentSource="Icon" />
                <ContentPresenter
                  x:Name="HeaderHost"
                  Grid.Column="1"
                  Margin="{TemplateBinding Padding}"
                  VerticalAlignment="Center"
                  ContentSource="Header"
                  RecognizesAccessKey="True" />
                <ContentPresenter
                  x:Name="IGTHost"
                  Grid.Column="2"
                  Margin="8,1,8,1"
                  VerticalAlignment="Center"
                  ContentSource="InputGestureText" />
                <Path
                  x:Name="SubMenuArrow"
                  Grid.Column="3"
                  Margin="4,0,4,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Data="M 0 0 L 4 4 L 0 8 Z"
                  Fill="{DynamicResource TrayTaskContextMenuItemTxtColor}"
                  Visibility="Collapsed" />
              </Grid>
            </Border>
            <Popup
              x:Name="SubMenuPopup"
              AllowsTransparency="True"
              Focusable="False"
              IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
              Placement="Right"
              PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}">
              <Border
                Margin="{DynamicResource TrayTaskContextMenuMargin}"
                Background="{DynamicResource TrayTaskContextMenuColor}"
                BorderBrush="{DynamicResource TrayTaskContextMenuBorderColor}"
                BorderThickness="{DynamicResource TrayTaskContextMenuBorderThickness}"
                CornerRadius="{DynamicResource TrayTaskContextMenuRounding}">
                <Border.Effect>
                  <DropShadowEffect
                    BlurRadius="{DynamicResource TrayTaskContextMenuDropShadowBlurRadius}"
                    Direction="{DynamicResource TrayTaskContextMenuDropShadowDirection}"
                    Opacity="{DynamicResource TrayTaskContextMenuDropShadowOpacity}"
                    RenderingBias="{DynamicResource TrayTaskContextMenuDropShadowRenderingBias}"
                    ShadowDepth="{DynamicResource TrayTaskContextMenuDropShadowShadowDepth}" />
                </Border.Effect>
                <ScrollViewer
                  CanContentScroll="False"
                  Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer,
                                                                TypeInTargetAssembly={x:Type FrameworkElement}}}">
                  <ItemsPresenter
                    Margin="{TemplateBinding Padding}"
                    KeyboardNavigation.DirectionalNavigation="Cycle"
                    Grid.IsSharedSizeScope="True"
                    UseLayoutRounding="{TemplateBinding UseLayoutRounding}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="True">
              <Setter TargetName="SubMenuArrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource TrayTaskContextMenuItemHoverColor}" />
              <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource TrayTaskContextMenuItemHoverBorderColor}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!--  Data templates for tray context menu items  -->
  <DataTemplate DataType="{x:Type local:PluginSubMenuItem}">
    <TextBlock Text="{Binding Header}" Foreground="{DynamicResource TrayTaskContextMenuItemTxtColor}" />
  </DataTemplate>

  <HierarchicalDataTemplate DataType="{x:Type local:PluginModel}" ItemsSource="{Binding SubMenuItems}">
    <HierarchicalDataTemplate.ItemContainerStyle>
      <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
        <Setter Property="Header" Value="{Binding Header}" />
        <Setter Property="Command" Value="{Binding Command}" />
        <Setter Property="CommandParameter" Value="{Binding CommandParameter}" />
        <Setter Property="Foreground" Value="{DynamicResource TrayTaskContextMenuItemTxtColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource ContextMenuFontSize}" />
        <Setter Property="UseLayoutRounding" Value="True" />
      </Style>
    </HierarchicalDataTemplate.ItemContainerStyle>
    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TrayTaskContextMenuItemTxtColor}" VerticalAlignment="Center" />
  </HierarchicalDataTemplate>

  <!--  The Context Menu  -->
  <ContextMenu
    x:Key="SysTrayMenu"
    x:Shared="false"
    UseLayoutRounding="True">
    <MenuItem
      Command="{Binding ToggleWindowCommand}"
      CommandParameter="{Binding}"
      Foreground="{DynamicResource TrayTaskContextMenuItemTxtColor}"
      Header="Toggle Search Window"
      UseLayoutRounding="True">
      <MenuItem.Icon>
        <Image
          Width="{DynamicResource TrayTaskContextMenuItemIconSize}"
          Height="{DynamicResource TrayTaskContextMenuItemIconSize}"
          Margin="{DynamicResource TrayTaskContextMenuItemIconMargin}"
          Source="pack://siteoforigin:,,,/Config/Resources/TraySearch.png"
          UseLayoutRounding="True" />
      </MenuItem.Icon>
    </MenuItem>
    <Separator Background="Transparent" />
    <MenuItem
      Command="{Binding OpenSettingsFile}"
      CommandParameter="{Binding}"
      Foreground="{DynamicResource TrayTaskContextMenuItemTxtColor}"
      Header="Settings"
      UseLayoutRounding="True">
      <MenuItem.Icon>
        <Image
          Width="{DynamicResource TrayTaskContextMenuItemIconSize}"
          Height="{DynamicResource TrayTaskContextMenuItemIconSize}"
          Margin="{DynamicResource TrayTaskContextMenuItemIconMargin}"
          Source="pack://siteoforigin:,,,/Config/Resources/settings.png"
          UseLayoutRounding="True" />
      </MenuItem.Icon>
    </MenuItem>
    <Separator Background="Transparent" />
    <MenuItem
      Foreground="{DynamicResource TrayTaskContextMenuItemTxtColor}"
      Header="PlugBoard"
      UseLayoutRounding="True">
      <MenuItem.Icon>
        <Image
          Width="{DynamicResource TrayTaskContextMenuItemIconSize}"
          Height="{DynamicResource TrayTaskContextMenuItemIconSize}"
          Margin="{DynamicResource TrayTaskContextMenuItemIconMargin}"
          Source="pack://siteoforigin:,,,/Config/Resources/plug.png"
          UseLayoutRounding="True" />
      </MenuItem.Icon>
      <MenuItem.ItemsSource>
        <CompositeCollection>
          <MenuItem
            Command="{Binding Source={x:Static local:NotifyIconViewModel.OpenPlugBoard}}"
            Foreground="{DynamicResource TrayTaskContextMenuItemTxtColor}"
            Header="Open PlugBoard"
            UseLayoutRounding="True" />
          <Separator Background="{DynamicResource TrayTaskContextMenuSeparatorColor}" />
          <CollectionContainer Collection="{Binding Source={x:Static local:NotifyIconViewModel.LoadedPluginModels}}" />
        </CompositeCollection>
      </MenuItem.ItemsSource>
      <MenuItem.ItemContainerStyle>
        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
          <Setter Property="Foreground" Value="{DynamicResource TrayTaskContextMenuItemTxtColor}" />
          <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
          <Setter Property="FontSize" Value="{DynamicResource ContextMenuFontSize}" />
          <Setter Property="UseLayoutRounding" Value="True" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=DataContext.GetType().Name}" Value="PluginModel">
              <Setter Property="Icon">
                <Setter.Value>
                  <Image
                    Width="{DynamicResource TrayTaskContextMenuItemIconSize}"
                    Height="{DynamicResource TrayTaskContextMenuItemIconSize}"
                    Margin="{DynamicResource TrayTaskContextMenuItemIconMargin}"
                    Source="{Binding PluginIconSource}"
                    UseLayoutRounding="True" />
                </Setter.Value>
              </Setter>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </MenuItem.ItemContainerStyle>
    </MenuItem>
    <Separator Background="{DynamicResource TrayTaskContextMenuSeparatorColor}" />
    <MenuItem
      Command="{Binding RestartApplicationCommand}"
      CommandParameter="{Binding}"
      Foreground="{DynamicResource TrayTaskContextMenuItemTxtColor}"
      Header="Restart"
      UseLayoutRounding="True">
      <MenuItem.Icon>
        <Image
          Width="{DynamicResource TrayTaskContextMenuItemIconSize}"
          Height="{DynamicResource TrayTaskContextMenuItemIconSize}"
          Margin="{DynamicResource TrayTaskContextMenuItemIconMargin}"
          Source="pack://siteoforigin:,,,/Config/Resources/restart.png"
          UseLayoutRounding="True" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem
      Command="{Binding ExitApplicationCommand}"
      CommandParameter="{Binding}"
      Foreground="{DynamicResource TrayTaskContextMenuItemTxtColor}"
      Header="Exit"
      UseLayoutRounding="True">
      <MenuItem.Icon>
        <Image
          Width="{DynamicResource TrayTaskContextMenuItemIconSize}"
          Height="{DynamicResource TrayTaskContextMenuItemIconSize}"
          Margin="{DynamicResource TrayTaskContextMenuItemIconMargin}"
          Source="pack://siteoforigin:,,,/Config/Resources/exit.png"
          UseLayoutRounding="True" />
      </MenuItem.Icon>
    </MenuItem>
  </ContextMenu>
  <!--  the applications tray task - tool-tip assigned in code  -->
  <tb:TaskbarIcon
    x:Key="NotifyIcon"
    ContextMenu="{StaticResource SysTrayMenu}"
    LeftClickCommand="{Binding ToggleWindowCommand}"
    ToolTipText="Quokka"
    UseLayoutRounding="True">
    <!--  self-assign a data context  -->
    <tb:TaskbarIcon.DataContext>
      <local:NotifyIconViewModel />
    </tb:TaskbarIcon.DataContext>
  </tb:TaskbarIcon>
  <!--  loading tray task  -->
  <tb:TaskbarIcon
    x:Key="LoadingNotifyIcon"
    ToolTipText="Quokka is initializing"
    UseLayoutRounding="True" />
</ResourceDictionary>